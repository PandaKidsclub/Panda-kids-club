# Optional public media origin. Leave unset to serve canonical local assets.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Panda Shop. Keep SHOP_ENABLED unset or false until a Shopify Storefront private token
# is configured in the deployment environment. Never prefix the private token with NEXT_PUBLIC_.
SHOP_ENABLED=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_DEFAULT_COUNTRY=ZA
SHOPIFY_FEATURED_COLLECTION_HANDLE=

# Only set true behind a deployment proxy whose forwarded IP header is trusted.
TRUST_PROXY_HEADERS=
